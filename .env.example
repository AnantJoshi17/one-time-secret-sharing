# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# .env is in .gitignore and must NEVER be committed. This file, with its
# placeholder values, is the one that goes in the repository so that anyone
# cloning it knows which variables they need.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local development, after following the PostgreSQL setup in the README:
DATABASE_URL=postgresql+psycopg2://secretshare:secretshare@localhost:5432/secretshare
#
# On Render, copy the "Internal Database URL" from your database's dashboard.
# It starts with postgres:// -- change that prefix to postgresql+psycopg2://
# or SQLAlchemy will not know which driver to use.

# --- JWT signing -----------------------------------------------------------
# Signs the login tokens. Anyone holding this value can forge a token for any
# user, so it must be long, random, and different in every environment.
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Secret encryption -----------------------------------------------------
# Encrypts the secret payloads at rest. This is a DIFFERENT key from
# JWT_SECRET_KEY on purpose -- they protect different things.
#
# It must be a valid Fernet key: 32 random bytes, url-safe base64 encoded
# (44 characters). Any other string will stop the app from starting.
# Generate one with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: if you change this key, every secret already in the database
# becomes permanently unreadable. There is no recovery.
SECRET_ENCRYPTION_KEY=replace-me-with-a-generated-fernet-key

# --- Secret behaviour ------------------------------------------------------
DEFAULT_TTL_MINUTES=60
MAX_TTL_MINUTES=10080
MAX_SECRET_LENGTH=10000

# --- Rate limiting (per client IP, on secret creation only) ----------------
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Maintenance -----------------------------------------------------------
# Shared token protecting POST /maintenance/cleanup. The caller is a cron job
# or uptime pinger, not a logged-in user, so it uses a header token rather
# than a JWT. Generate one the same way as JWT_SECRET_KEY.
CLEANUP_TOKEN=replace-me-with-another-long-random-string

# --- Misc ------------------------------------------------------------------
# Used to build the share_url returned when a secret is created. Set this to
# your real public URL in production, e.g. https://your-app.onrender.com
PUBLIC_BASE_URL=http://localhost:8000
